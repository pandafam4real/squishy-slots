>>>>>>> 623ce4274371f55a3ea666311fe41493bbc4c891
    name: 'Golden Jin-Deui', type: 'Sesame Ball', rarity: 'legendary', weight: 2
  }
};

const SYMBOL_KEYS = Object.keys(SYMBOLS);
const RARITY_WEIGHTS = {};
SYMBOL_KEYS.forEach(k => RARITY_WEIGHTS[k] = SYMBOLS[k].weight);
const TOTAL_WEIGHT = Object.values(RARITY_WEIGHTS).reduce((a, b) => a + b, 0);

// ── AUDIO ──────────────────────────────────────────────────────
let audioCtx = null;
function getAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); return audioCtx; }
function playTone(freq, type, dur, vol = 0.3, startTime = 0) {
  const ctx = getAudio(), osc = ctx.createOscillator(), gain = ctx.createGain();
  osc.connect(gain); gain.connect(ctx.destination);
  osc.type = type; osc.frequency.value = freq;
  const t = ctx.currentTime + startTime;
  gain.gain.setValueAtTime(0, t);
  gain.gain.linearRampToValueAtTime(vol, t + 0.01);
  gain.gain.exponentialRampToValueAtTime(0.001, t + dur);
  osc.start(t); osc.stop(t + dur + 0.05);
}
function playNoise(dur, vol = 0.15, startTime = 0) {
  const ctx = getAudio(), buf = ctx.createBuffer(1, ctx.sampleRate * dur, ctx.sampleRate), d = buf.getChannelData(0);
  for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
  const src = ctx.createBufferSource(), gain = ctx.createGain(), filter = ctx.createBiquadFilter();
  filter.type = 'highpass'; filter.frequency.value = 1000;
  src.buffer = buf; src.connect(filter); filter.connect(gain); gain.connect(ctx.destination);
  const t = ctx.currentTime + startTime;
  gain.gain.setValueAtTime(0, t);
  gain.gain.linearRampToValueAtTime(vol, t + 0.01);
  gain.gain.exponentialRampToValueAtTime(0.001, t + dur);
  src.start(t); src.stop(t + dur);
}
function soundWhoosh() { playNoise(0.3, 0.2); playTone(400, 'sine', 0.3, 0.1); }
function soundTick() {
  const ctx = getAudio(), buf = ctx.createBuffer(1, ctx.sampleRate * 0.03, ctx.sampleRate), d = buf.getChannelData(0);
  for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (d.length * 0.3));
  const src = ctx.createBufferSource(); src.buffer = buf; const g = ctx.createGain(); g.gain.value = 0.12; src.connect(g); g.connect(ctx.destination); src.start();
}
function soundThud() { playTone(80, 'sine', 0.15, 0.4); playTone(60, 'sine', 0.1, 0.2); }
function soundCoin() { for (let i = 0; i < 6; i++) setTimeout(() => playTone(800 + i * 200, 'sine', 0.1, 0.2), i * 60); }
function soundJackpot() { [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => playTone(f, 'sine', 0.4, 0.3), i * 150)); setTimeout(() => [1047, 1319, 1568, 2093].forEach((f, i) => setTimeout(() => playTone(f, 'square', 0.3, 0.15), i * 100)), 600); }
function soundNearMiss() { playTone(200, 'sine', 0.3, 0.2); setTimeout(() => playTone(180, 'sine', 0.4, 0.15), 200); }
function soundClick() { playTone(600, 'sine', 0.05, 0.25); }

// ── STATE ──────────────────────────────────────────────────────
const STORAGE_KEYS = { balance: 'ysq_balance', lastSpin: 'ysq_lastSpin', streak: 'ysq_streak', lastVisit: 'ysq_lastVisit', collection: 'ysq_collection', biggestWin: 'ysq_biggestWin', leaderboard: 'ysq_leaderboard', bonusUsed: 'ysq_bonusUsed' };
let state = { balance: 1000, freeSpinReady: false, bonusSpins: 0, spinning: false, collection: {}, dailyStreak: 1, biggestWin: 0 };
const COL_CELLS = [[0, 5, 10, 15, 20], [1, 6, 11, 16, 21], [2, 7, 12, 17, 22], [3, 8, 13, 18, 23], [4, 9, 14, 19, 24]];

function loadState() {
  state.balance = parseInt(localStorage.getItem(STORAGE_KEYS.balance)) || 1000;
  state.biggestWin = parseInt(localStorage.getItem(STORAGE_KEYS.biggestWin)) || 0;
  const lastVisit = localStorage.getItem(STORAGE_KEYS.lastVisit);
  const now = new Date();
  if (lastVisit) {
    const gap = (now - new Date(lastVisit)) / 1000 / 3600;
    if (gap >= 24) state.dailyStreak = 1;
    else if (gap >= 1) state.dailyStreak = parseInt(localStorage.getItem(STORAGE_KEYS.streak)) || 1;
  }
  state.collection = JSON.parse(localStorage.getItem(STORAGE_KEYS.collection) || '{}');
  const lastSpin = localStorage.getItem(STORAGE_KEYS.lastSpin);
  if (lastSpin) { const elapsed = (now - new Date(lastSpin)) / 1000; state.freeSpinReady = elapsed >= 14400; }
  else state.freeSpinReady = true;
}
function saveBalance() { localStorage.setItem(STORAGE_KEYS.balance, state.balance); }
function saveCollection() { localStorage.setItem(STORAGE_KEYS.collection, JSON.stringify(state.collection)); }
function saveStreak() { localStorage.setItem(STORAGE_KEYS.streak, state.dailyStreak); localStorage.setItem(STORAGE_KEYS.lastVisit, new Date().toISOString()); }
function saveLastSpin() { localStorage.setItem(STORAGE_KEYS.lastSpin, new Date().toISOString()); }
function saveBiggestWin() { localStorage.setItem(STORAGE_KEYS.biggestWin, state.biggestWin); }
function updateLeaderboard(score) { let lb = JSON.parse(localStorage.getItem(STORAGE_KEYS.leaderboard) || '[]'); lb.push({ score, date: new Date().toLocaleDateString() }); lb.sort((a, b) => b.score - a.score); localStorage.setItem(STORAGE_KEYS.leaderboard, JSON.stringify(lb.slice(0, 20))); }

// ── UI ─────────────────────────────────────────────────────────
function buildGrid() {
  const grid = document.getElementById('slotGrid'); grid.innerHTML = '';
  for (let i = 0; i < 25; i++) { const cell = document.createElement('div'); cell.className = 'slot-cell'; cell.id = 'cell' + i; cell.innerHTML = SYMBOLS.baobao.svg; grid.appendChild(cell); }
}
function buildCollection() {
  const row = document.getElementById('collectionRow'); row.innerHTML = '';
  SYMBOL_KEYS.forEach(key => {
    const div = document.createElement('div'); div.className = 'col-item' + (state.collection[key] ? ' collected' : '');
    div.id = 'col-' + key; div.innerHTML = SYMBOLS[key].svg; div.title = `${SYMBOLS[key].name} — ${SYMBOLS[key].type}`; row.appendChild(div);
  });
  const total = SYMBOL_KEYS.filter(k => state.collection[k]).length;
  document.getElementById('collectProgress').textContent = `${total}/${SYMBOL_KEYS.length} Collected`;
  if (total === SYMBOL_KEYS.length && !localStorage.getItem(STORAGE_KEYS.bonusUsed)) { setTimeout(() => showBonus(), 500); }
}
function updateBalanceUI(animate = true) { const el = document.getElementById('coinBalance'); el.textContent = state.balance.toLocaleString(); if (animate) { el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop'); } }
function updateStreakUI() { document.getElementById('streakText').textContent = 'Day ' + state.dailyStreak; }
function updateSpinButton() {
  const btn = document.getElementById('spinBtn');
  if (state.bonusSpins > 0) { btn.classList.add('free-spin'); btn.querySelector('.spin-cost').textContent = `FREE (${state.bonusSpins})`; }
  else if (state.freeSpinReady) { btn.classList.add('free-spin'); btn.querySelector('.spin-cost').textContent = 'FREE SPIN!'; }
  else { btn.classList.remove('free-spin'); btn.querySelector('.spin-cost').textContent = '10 coins'; }
}

// ── SLOT LOGIC ────────────────────────────────────────────────
function pickSymbol() { let r = Math.random() * TOTAL_WEIGHT; for (const key of SYMBOL_KEYS) { r -= RARITY_WEIGHTS[key]; if (r <= 0) return key; } return SYMBOL_KEYS[0]; }
function lineCellIndices(lineIdx, posInLine) { if (lineIdx < 5) return lineIdx * 5 + posInLine; else if (lineIdx < 10) return COL_CELLS[lineIdx - 5][posInLine]; else if (lineIdx === 10) return posInLine * 6; else return 4 + posInLine * 4; }

function generateResult() {
  const pool = []; SYMBOL_KEYS.forEach(k => { for (let i = 0; i < RARITY_WEIGHTS[k]; i++) pool.push(k); });
  const pick = () => pool[Math.floor(Math.random() * pool.length)];
  const grid = Array.from({ length: 25 }, () => pick());
  const lines = [];
  for (let r = 0; r < 5; r++) lines.push([grid[r * 5], grid[r * 5 + 1], grid[r * 5 + 2], grid[r * 5 + 3], grid[r * 5 + 4]]);
  for (let c = 0; c < 5; c++) lines.push([grid[c], grid[5 + c], grid[10 + c], grid[15 + c], grid[20 + c]]);
  lines.push([grid[0], grid[6], grid[12], grid[18], grid[24]]);
  lines.push([grid[4], grid[8], grid[12], grid[16], grid[20]]);
  const lineMatches = lines.map((line) => {
    const symCount = {}; line.forEach(s => symCount[s] = (symCount[s] || 0) + 1);
    let bestKey = null, bestCount = 0, bestPos = [];
    Object.entries(symCount).forEach(([k, v]) => { if (v > bestCount) { bestCount = v; bestKey = k; } });
    if (bestCount >= 3) { line.forEach((s, pi) => { if (s === bestKey) bestPos.push(pi); }); }
    return { key: bestKey, count: bestCount, positions: bestPos };
  });
  let totalWin = 0, winningCells = new Set(), jackpot = false, nearMiss = false;
  lineMatches.forEach((lm, li) => {
    if (lm.count >= 3) {
      const payTable = { 3: 50, 4: 200, 5: 500 }; let win = payTable[lm.count] || 50;
      if (lm.key === 'jin' && lm.count >= 3) { win = 5000; jackpot = true; }
      totalWin += win; lm.positions.forEach(pos => winningCells.add(lineCellIndices(li, pos)));
    }
  });
  if (!jackpot && totalWin === 0) {
    lineMatches.forEach((lm) => { if (lm.count === 2) { nearMiss = true; lm.positions.forEach(pos => winningCells.add(lineCellIndices(li, pos))); } });
    if (nearMiss) totalWin = 3 + Math.floor(Math.random() * 3);
  }
  if (totalWin === 0 && Math.random() < 0.7) totalWin = 5 + Math.floor(Math.random() * 10);
  return { grid, totalWin, winningCells: Array.from(winningCells), jackpot, nearMiss };
}

// ── SPIN ───────────────────────────────────────────────────────
async function doSpin() {
  if (state.spinning) return;
  soundClick();
  const isFreeSpin = state.bonusSpins > 0 || state.freeSpinReady;
  if (!isFreeSpin && state.balance < 10) { setStatus('Not enough coins!', 'nearmiss-text'); return; }
  if (!isFreeSpin) { state.balance -= 10; saveLastSpin(); } else { state.bonusSpins = Math.max(0, state.bonusSpins - 1); if (state.bonusSpins === 0 && state.freeSpinReady) state.freeSpinReady = false; }
  state.spinning = true;
  const btn = document.getElementById('spinBtn');
  btn.disabled = true; btn.classList.remove('pulse'); btn.classList.add('pressed');
  setTimeout(() => btn.classList.remove('pressed'), 100);
  updateBalanceUI(); updateSpinButton();
  const result = generateResult();
  const colStopTimes = [700, 1000, 1300, 1600, 1900];
  soundWhoosh();
  let tickInterval = setInterval(soundTick, 60);
  for (let i = 0; i < 25; i++) document.getElementById('cell' + i).classList.add('spinning');
  for (let col = 0; col < 5; col++) {
    await new Promise(res => setTimeout(res, col === 0 ? colStopTimes[0] : colStopTimes[col] - colStopTimes[col - 1]));
    COL_CELLS[col].forEach(cellIdx => { const el = document.getElementById('cell' + cellIdx); el.classList.remove('spinning'); el.innerHTML = SYMBOLS[result.grid[cellIdx]].svg; });
    soundThud();
    COL_CELLS[col].forEach(cellIdx => { state.collection[result.grid[cellIdx]] = (state.collection[result.grid[cellIdx]] || 0) + 1; });
  }
  clearInterval(tickInterval);
  await new Promise(res => setTimeout(res, 300));
  result.winningCells.forEach(idx => {
    const el = document.getElementById('cell' + idx);
    if (result.jackpot) el.classList.add('winner');
    else if (result.nearMiss) {
      el.classList.add('nearmiss');
      const float = document.createElement('div'); float.className = 'nearmiss-float';
      float.textContent = result.totalWin > 0 ? 'SO CLOSE!' : '';
      el.appendChild(float);
      setTimeout(() => { el.classList.remove('nearmiss'); float.remove(); }, 900);
    }
  });
  if (result.jackpot) { soundJackpot(); state.balance += result.totalWin; if (state.balance > state.biggestWin) state.biggestWin = state.balance; saveBiggestWin(); updateBalanceUI(); showJackpot(result.totalWin); confetti(); flashScreen(); }
  else if (result.totalWin > 0) {
    if (result.nearMiss) { soundNearMiss(); setStatus(`+${result.totalWin} coins!`, 'nearmiss-text'); }
    else { soundCoin(); setStatus(`+${result.totalWin} coins!`, 'win-text'); }
    state.balance += result.totalWin; if (state.balance > state.biggestWin) state.biggestWin = state.balance; saveBiggestWin(); updateBalanceUI(); coinRain(result.totalWin);
  } else setStatus('No match...', '');
  saveBalance(); saveCollection(); updateLeaderboard(state.balance); buildCollection();
  setTimeout(() => { for (let i = 0; i < 25; i++) document.getElementById('cell' + i).classList.remove('winner', 'nearmiss'); state.spinning = false; btn.disabled = false; btn.classList.add('pulse'); updateSpinButton(); }, 2200);
  const now = new Date(), lastVisit = localStorage.getItem(STORAGE_KEYS.lastVisit);
  if (lastVisit) { const gap = (now - new Date(lastVisit)) / 1000 / 3600; if (gap >= 1 && gap < 24) state.dailyStreak++; else if (gap >= 24) state.dailyStreak = 1; }
  saveStreak(); updateStreakUI(); startFreeTimer();
}
function setStatus(msg, cls) { const el = document.getElementById('statusMsg'); el.className = cls; el.textContent = msg; }

// ── EFFECTS ────────────────────────────────────────────────────
function coinRain(amount) { const count = Math.min(amount, 30); for (let i = 0; i < count; i++) { setTimeout(() => { const el = document.createElement('div'); el.className = 'coin-rain'; el.textContent = '🪙'; el.style.left = (Math.random() * 88) + 'vw'; el.style.animationDuration = (1.5 + Math.random()) + 's'; document.body.appendChild(el); setTimeout(() => el.remove(), 3000); }, i * 50); } }
function confetti() { const colors = ['#ff6b9d', '#5dd9c1', '#b4a0ff', '#ffe066', '#7ec8e3', '#ff9f1c', '#ffd700', '#ff85ad']; for (let i = 0; i < 60; i++) { setTimeout(() => { const el = document.createElement('div'); el.className = 'confetti-piece'; el.style.left = (Math.random() * 88) + 'vw'; el.style.top = (Math.random() * 30) + 'vh'; el.style.background = colors[Math.floor(Math.random() * colors.length)]; el.style.animationDuration = (2 + Math.random() * 1.5) + 's'; el.style.width = (8 + Math.random() * 8) + 'px'; el.style.height = (8 + Math.random() * 8) + 'px'; el.style.borderRadius = Math.random() > 0.5 ? '50%' : '3px'; document.body.appendChild(el); setTimeout(() => el.remove(), 4000); }, i * 30); } }
function flashScreen() { const el = document.createElement('div'); el.className = 'jackpot-flash'; document.body.appendChild(el); setTimeout(() => el.remove(), 1500); }

// ── TIMER ─────────────────────────────────────────────────────
let freeTimerInterval = null;
function startFreeTimer() {
  if (freeTimerInterval) clearInterval(freeTimerInterval);
  const tick = () => {
    const lastSpin = localStorage.getItem(STORAGE_KEYS.lastSpin);
    const timerEl = document.getElementById('freeTimer');
    if (!lastSpin) { timerEl.textContent = 'READY!'; state.freeSpinReady = true; updateSpinButton(); return; }
    const remaining = Math.max(0, 14400 - (new Date() - new Date(lastSpin)) / 1000);
    if (remaining <= 0) { timerEl.textContent = 'READY!'; state.freeSpinReady = true; updateSpinButton(); return; }
    const h = Math.floor(remaining / 3600), m = Math.floor((remaining % 3600) / 60), s = Math.floor(remaining % 60);
    timerEl.textContent = `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`; state.freeSpinReady = false; updateSpinButton();
  };
  tick(); freeTimerInterval = setInterval(tick, 1000);
}

// ── MODALS ─────────────────────────────────────────────────────
function showJackpot(amount) { document.getElementById('jackpotMsg').textContent = `You won ${amount.toLocaleString()} coins!`; document.getElementById('jackpotOverlay').classList.add('active'); }
function closeJackpot() { document.getElementById('jackpotOverlay').classList.remove('active'); }
function showBonus() { document.getElementById('bonusOverlay').classList.add('active'); state.bonusSpins = 3; localStorage.setItem(STORAGE_KEYS.bonusUsed, 'true'); updateSpinButton(); }
function closeBonus() { document.getElementById('bonusOverlay').classList.remove('active'); }
function showLeaderboard() { const lb = JSON.parse(localStorage.getItem(STORAGE_KEYS.leaderboard) || '[]'); const top = lb.slice(0, 10); const list = document.getElementById('leaderList'); list.innerHTML = ''; if (top.length === 0) list.innerHTML = '<li style="justify-content:center;color:#888">No scores yet!</li>'; top.forEach((entry, i) => { const li = document.createElement('li'); const rankClass = i === 0 ? 'r1' : i === 1 ? 'r2' : 'r3'; li.innerHTML = `<span class="leader-rank ${rankClass}">${i + 1}</span><span>${entry.date}</span><span class="leader-bal">${entry.score.toLocaleString()}</span>`; list.appendChild(li); }); document.getElementById('currentBalance').textContent = `Balance: ${state.balance.toLocaleString()} coins`; document.getElementById('leaderOverlay').classList.add('active'); }
function closeLeaderboard() { document.getElementById('leaderOverlay').classList.remove('active'); }
function shareScore() { const msg = `🍜 Hit ${state.biggestWin.toLocaleString()} coins on Yum Sum Squishies! Can you beat me?\n\n👉 pandafam4real.github.io/squishy-slots`; if (navigator.clipboard) { navigator.clipboard.writeText(msg).then(() => { const btn = document.querySelector('.share-btn'); const orig = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => btn.textContent = orig, 2000); }); } }

// ── INIT ───────────────────────────────────────────────────────
function init() { loadState(); buildGrid(); buildCollection(); updateBalanceUI(false); updateStreakUI(); updateSpinButton(); startFreeTimer(); for (let i = 0; i < 25; i++) document.getElementById('cell' + i).innerHTML = SYMBOLS[pickSymbol()].svg; }
init();
</script>
</body>
</html>
