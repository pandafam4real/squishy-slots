<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yum Sum Squishies</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0d0d1a;--pink:#ff6b9d;--mint:#5dd9c1;--lav:#b4a0ff;--butter:#ffe066;--gold:#ffd700;--peach:#ffb347;}
html,body{min-height:100vh;background:var(--bg);background-image:radial-gradient(ellipse at 20% 0%,rgba(107,91,204,0.18) 0%,transparent 55%),radial-gradient(ellipse at 80% 100%,rgba(255,107,157,0.12) 0%,transparent 55%),radial-gradient(ellipse at 50% 50%,rgba(30,30,60,0.9) 0%,transparent 100%);font-family:'Nunito',sans-serif;color:#fff;overflow-x:hidden}
body{display:flex;flex-direction:column;align-items:center;padding:20px 8px 100px}
.header{display:flex;justify-content:space-between;align-items:center;width:100%;max-width:420px;margin-bottom:20px}
.coin-wrap{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#1a1a3a,#252550);border-radius:24px;padding:10px 20px;box-shadow:0 4px 20px rgba(0,0,0,0.5);border:1px solid rgba(255,215,0,0.2)}
.coin-icon{width:36px;height:36px;background:linear-gradient(145deg,#fff0a0,#ffd700,#b8860b);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#7a4a00;box-shadow:0 2px 8px rgba(255,215,0,0.5),inset 0 2px 4px rgba(255,255,255,0.4)}
#coinBalance{font-size:26px;font-weight:900;transition:transform 0.2s}
#coinBalance.pop{animation:pop 0.3s}
@keyframes pop{0%{transform:scale(1)}50%{transform:scale(1.35)}100%{transform:scale(1)}}
.streak-badge{display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,#1a1a3a,#252550);border-radius:24px;padding:10px 16px;box-shadow:0 4px 20px rgba(0,0,0,0.5);border:1px solid rgba(255,159,79,0.2)}
.streak-badge svg{width:24px;height:24px}
#streakText{font-size:14px;font-weight:800;color:var(--peach)}
.machine-container{perspective:1200px;width:100%;max-width:420px}
.machine{background:linear-gradient(160deg,#2a2a5a 0%,#1e1e3a 40%,#181830 100%);border-radius:32px;padding:24px 16px 20px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.7),0 0 0 1px rgba(255,255,255,0.06),inset 0 1px 0 rgba(255,255,255,0.1),inset 0 -2px 0 rgba(0,0,0,0.3);transform:rotateX(3deg);transform-style:preserve-3d;position:relative}
.machine::before{content:'';position:absolute;top:0;left:10%;right:10%;height:3px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.15),rgba(255,255,255,0.3),rgba(255,255,255,0.15),transparent);border-radius:0 0 3px 3px}
.machine-title{text-align:center;font-size:20px;font-weight:900;letter-spacing:3px;margin-bottom:14px;background:linear-gradient(135deg,#ffd700 0%,#ff9f1c 30%,#ff6b9d 60%,#b4a0ff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 2px 6px rgba(255,107,157,0.5))}
.slot-grid-wrap{background:linear-gradient(180deg,#080810 0%,#0d0d1a 100%);border-radius:24px;padding:10px;border:3px solid #222;box-shadow:inset 0 6px 24px rgba(0,0,0,0.95),0 0 0 1px rgba(0,0,0,0.4)}
.slot-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.slot-cell{aspect-ratio:1;background:linear-gradient(145deg,#141428,#0c0c1e);border-radius:16px;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;border:2px solid #1e1e3a;box-shadow:inset 0 3px 8px rgba(0,0,0,0.8),inset 0 0 0 1px rgba(255,255,255,0.02),0 2px 0 rgba(255,255,255,0.03)}
.slot-cell::after{content:'';position:absolute;inset:0;border-radius:14px;background:linear-gradient(145deg,rgba(255,255,255,0.09) 0%,transparent 40%,rgba(255,255,255,0.04) 100%);pointer-events:none}
.slot-cell svg{width:88%;height:88%;filter:drop-shadow(0 6px 14px rgba(0,0,0,0.9))}
.slot-cell.winner{border-color:var(--gold);box-shadow:inset 0 3px 8px rgba(0,0,0,0.6),0 0 28px rgba(255,215,0,0.75),0 0 56px rgba(255,215,0,0.35);animation:winBounce3d 0.5s ease-in-out infinite alternate}
@keyframes winBounce3d{from{transform:scale(1) translateY(0)}to{transform:scale(1.08) translateY(-4px)}}
.slot-cell.nearmiss{border-color:var(--peach);animation:shake3d 0.4s ease;box-shadow:inset 0 3px 8px rgba(0,0,0,0.6),0 0 18px rgba(255,179,71,0.5)}
@keyframes shake3d{0%,100%{transform:translateX(0)}20%{transform:translateX(-5px) rotate(-2deg)}40%{transform:translateX(5px) rotate(2deg)}60%{transform:translateX(-3px) rotate(-1deg)}80%{transform:translateX(3px) rotate(1deg)}}
.paytable{margin-top:14px;font-size:10px;color:#777;text-align:center;line-height:1.9}
.paytable span{color:var(--butter);font-weight:800}
.spin-wrap{text-align:center;margin-top:18px;perspective:500px}
#spinBtn{width:92%;max-width:340px;height:76px;border:none;border-radius:38px;background:linear-gradient(160deg,#ff85ad 0%,#ff6b9d 30%,#d44a80 70%,#b33d6a 100%);color:#fff;font-family:'Nunito',sans-serif;font-size:26px;font-weight:900;letter-spacing:3px;cursor:pointer;position:relative;box-shadow:0 8px 0 #8a2250,0 12px 24px rgba(212,74,128,0.5),inset 0 2px 0 rgba(255,255,255,0.25),inset 0 -2px 0 rgba(0,0,0,0.15);transform:translateY(0);transition:transform 0.08s,box-shadow 0.08s;text-shadow:0 2px 4px rgba(0,0,0,0.3);overflow:hidden}
#spinBtn::before{content:'';position:absolute;top:4px;left:15%;right:15%;height:40%;background:linear-gradient(180deg,rgba(255,255,255,0.28),transparent);border-radius:50% 50% 40% 40%;pointer-events:none}
#spinBtn:hover{transform:translateY(-3px);box-shadow:0 11px 0 #8a2250,0 16px 32px rgba(212,74,128,0.65),inset 0 2px 0 rgba(255,255,255,0.3),inset 0 -2px 0 rgba(0,0,0,0.15)}
#spinBtn:active,#spinBtn.pressed{transform:translateY(6px);box-shadow:0 2px 0 #8a2250,0 4px 12px rgba(212,74,128,0.4),inset 0 2px 0 rgba(255,255,255,0.1),inset 0 -1px 0 rgba(0,0,0,0.2)}
#spinBtn:disabled{opacity:0.5;cursor:not-allowed;transform:none}
#spinBtn.pulse{animation:pulse3d 2s ease-in-out infinite}
@keyframes pulse3d{0%,100%{box-shadow:0 8px 0 #8a2250,0 12px 24px rgba(212,74,128,0.5),inset 0 2px 0 rgba(255,255,255,0.25),inset 0 -2px 0 rgba(0,0,0,0.15)}50%{box-shadow:0 8px 0 #8a2250,0 12px 44px rgba(255,107,157,0.85),inset 0 2px 0 rgba(255,255,255,0.25),inset 0 -2px 0 rgba(0,0,0,0.15)}}
#spinBtn.free-spin{background:linear-gradient(160deg,#7ee8d9 0%,#5dd9c1 30%,#2a9d8f 70%,#1e7a6d 100%);box-shadow:0 8px 0 #1a5c4c,0 12px 24px rgba(45,180,155,0.4),inset 0 2px 0 rgba(255,255,255,0.3),inset 0 -2px 0 rgba(0,0,0,0.15)}
#spinBtn.free-spin::before{background:linear-gradient(180deg,rgba(255,255,255,0.35),transparent)}
.spin-cost{display:block;font-size:12px;font-weight:700;margin-top:2px;opacity:0.85;letter-spacing:1px}
.status-area{min-height:52px;display:flex;align-items:center;justify-content:center;margin-top:14px}
#statusMsg{font-size:22px;font-weight:900;text-align:center;transition:opacity 0.3s;letter-spacing:1px}
.win-text{color:var(--gold)!important;text-shadow:0 0 20px var(--gold),0 0 40px rgba(255,215,0,0.5)}
.nearmiss-text{color:var(--peach)!important;text-shadow:0 0 15px rgba(255,179,71,0.6)}
.jackpot-text{color:var(--gold)!important;font-size:30px!important;text-shadow:0 0 30px var(--gold),0 0 60px rgba(255,215,0,0.8);animation:jackpotGlow 0.4s ease-in-out infinite alternate}
@keyframes jackpotGlow{from{text-shadow:0 0 20px var(--gold),0 0 40px rgba(255,215,0,0.4)}to{text-shadow:0 0 40px var(--gold),0 0 80px rgba(255,215,0,0.8),0 0 120px rgba(255,159,71,0.4)}}
.footer{position:fixed;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(13,13,26,0.98) 60%,transparent);padding:20px 16px 28px;display:flex;flex-direction:column;align-items:center;gap:10px;backdrop-filter:blur(10px)}
.timer-row{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700;color:#888}
.timer-row svg{width:18px;height:18px}
.free-timer{color:var(--mint)}
.collection-row{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;max-width:440px}
.col-item{width:40px;height:40px;background:linear-gradient(145deg,#1e1e3a,#141428);border-radius:10px;display:flex;align-items:center;justify-content:center;border:2px solid #2a2a4a;transition:all 0.3s;box-shadow:inset 0 1px 3px rgba(0,0,0,0.4)}
.col-item.collected{border-color:var(--lav);box-shadow:inset 0 1px 3px rgba(0,0,0,0.4),0 0 10px rgba(180,160,255,0.3)}
.col-item svg{width:28px;height:28px;opacity:0.12;transition:opacity 0.3s}
.col-item.collected svg{opacity:1}
.collect-progress{font-size:12px;font-weight:800;color:var(--lav)}
.btn-row{display:flex;gap:10px}
.footer-btn{padding:10px 22px;border:none;border-radius:22px;cursor:pointer;font-family:'Nunito',sans-serif;font-size:13px;font-weight:800;transition:transform 0.1s,box-shadow 0.1s}
.footer-btn:hover{transform:translateY(-2px)}
.share-btn{background:linear-gradient(135deg,#7ee8d9,#5dd9c1);color:#0d2e28;box-shadow:0 4px 12px rgba(93,217,193,0.3)}
.lead-btn{background:linear-gradient(135deg,#c4a8ff,#9b7ce8);color:#fff;box-shadow:0 4px 12px rgba(155,124,232,0.3)}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.88);display:flex;align-items:center;justify-content:center;z-index:100;opacity:0;pointer-events:none;transition:opacity 0.3s;backdrop-filter:blur(8px)}
.overlay.active{opacity:1;pointer-events:all}
.modal{background:linear-gradient(160deg,#2a2a5a,#1e1e3a);border-radius:28px;padding:32px 24px;max-width:360px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.8),inset 0 1px 0 rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.08)}
.modal h2{font-size:24px;font-weight:900;margin-bottom:16px;background:linear-gradient(135deg,#ff9f1c,#ff6b9d,#b4a0ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.modal p{font-size:14px;color:#aaa;line-height:1.7;margin-bottom:16px}
.modal-close{background:linear-gradient(160deg,#ff85ad,#ff6b9d);color:#fff;border:none;padding:14px 36px;border-radius:28px;font-family:'Nunito',sans-serif;font-size:16px;font-weight:800;cursor:pointer;box-shadow:0 4px 0 #b33d6a,0 6px 16px rgba(255,107,157,0.4);transition:transform 0.1s,box-shadow 0.1s}
.modal-close:hover{transform:translateY(-2px);box-shadow:0 6px 0 #b33d6a,0 8px 20px rgba(255,107,157,0.5)}
.modal-close:active{transform:translateY(3px);box-shadow:0 1px 0 #b33d6a}
.leader-list{list-style:none;text-align:left;margin:16px 0}
.leader-list li{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.06);font-size:14px;font-weight:700}
.leader-rank{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;flex-shrink:0}
.leader-rank.r1{background:linear-gradient(135deg,#ffd700,#ff9f1c);color:#7a4a00}
.leader-rank.r2{background:linear-gradient(135deg,#e0e0e0,#a0a0a0);color:#333}
.leader-rank.r3{background:linear-gradient(135deg,#cd7f32,#a0522d);color:#fff}
.leader-bal{color:var(--butter);margin-left:auto;font-weight:800}
.coin-rain{position:fixed;top:-40px;pointer-events:none;z-index:200;font-size:30px;animation:coinFall3d 1.8s ease-in forwards;filter:drop-shadow(0 4px 8px rgba(0,0,0,0.5))}
@keyframes coinFall3d{0%{transform:translateY(0) rotate(0deg) scale(1);opacity:1}80%{opacity:1}100%{transform:translateY(110vh) rotate(720deg) scale(0.8);opacity:0}}
.jackpot-flash{position:fixed;inset:0;background:radial-gradient(circle,rgba(255,215,0,0.7),rgba(255,107,157,0.3),transparent 70%);z-index:150;opacity:0;pointer-events:none;animation:flashIn3d 1.2s forwards}
@keyframes flashIn3d{0%{opacity:1}100%{opacity:0}}
.confetti-piece{position:fixed;border-radius:3px;z-index:160;animation:confettiFall3d 2.5s ease-in forwards;filter:drop-shadow(0 4px 8px rgba(0,0,0,0.4))}
@keyframes confettiFall3d{0%{transform:translateY(0) rotate(0deg);opacity:1}100%{transform:translateY(110vh) rotate(1080deg) scale(0.6);opacity:0}}
.slot-cell.spinning svg{animation:spinCycle3d 0.12s linear infinite;filter:drop-shadow(0 0 12px rgba(255,255,255,0.4))}
@keyframes spinCycle3d{0%{transform:translateY(-100%) scale(0.88);opacity:0.4}50%{transform:translateY(0) scale(1.06);opacity:1}100%{transform:translateY(100%) scale(0.88);opacity:0.4}}
.nearmiss-float{position:absolute;top:-14px;left:50%;transform:translateX(-50%);font-size:13px;font-weight:900;color:var(--peach);animation:floatUp3d 0.9s ease-out forwards;white-space:nowrap;z-index:10;text-shadow:0 0 10px rgba(255,179,71,0.8)}
@keyframes floatUp3d{0%{opacity:1;top:-14px;transform:translateX(-50%) scale(0.8)}50%{opacity:1;transform:translateX(-50%) scale(1.1)}100%{opacity:0;top:-50px;transform:translateX(-50%) scale(0.9)}}
@media(max-width:380px){.machine-title{font-size:17px}#spinBtn{font-size:22px;height:64px}.col-item{width:34px;height:34px}.col-item svg{width:22px;height:22px}#coinBalance{font-size:22px}}
</style>
</head>
<body>

<div class="header">
  <div class="coin-wrap"><div class="coin-icon">$</div><span id="coinBalance">1,000</span></div>
  <div class="streak-badge">
    <svg viewBox="0 0 24 24" fill="none"><path d="M12 2C8 6 6 10 8 14c1 2 3 3 4 4 1-1 3-2 4-4 2-4 0-8-4-12z" fill="#ff9f1c"/><path d="M12 8c-2 2.5-3.5 5-2.5 7.5.5 1.25 1.5 2 2.5 2.5.5-.5 1.5-1.25 2.5-2.5 1-2.5-.5-5-2.5-7.5z" fill="#ffd700"/></svg>
    <span id="streakText">Day 1</span>
  </div>
</div>

<div class="machine-container">
  <div class="machine">
    <div class="machine-title">YUM SUM SQUISHIES</div>
    <div class="slot-grid-wrap"><div class="slot-grid" id="slotGrid"></div></div>
    <div class="paytable">
      <span>3 Match = 50</span> &nbsp;|&nbsp; <span>4 Match = 200</span> &nbsp;|&nbsp; <span>5 Match = 500</span><br>
      <span>JACKPOT (3x Golden) = 5000</span> &nbsp;|&nbsp; <span>Near Miss = 3–5 coins</span>
    </div>
  </div>
</div>

<div class="spin-wrap">
  <button id="spinBtn" class="pulse" onclick="doSpin()">SQUEEZE!<span class="spin-cost">10 coins</span></button>
</div>

<div class="status-area"><div id="statusMsg"></div></div>

<div class="footer">
  <div class="timer-row">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
    <span class="free-timer" id="freeTimerLabel">Free spin in </span>
    <span class="free-timer" id="freeTimer">–:––:––</span>
  </div>
  <div class="collection-row" id="collectionRow"></div>
  <div class="collect-progress" id="collectProgress">0/6 Collected</div>
  <div class="btn-row">
    <button class="footer-btn share-btn" onclick="shareScore()">Share</button>
    <button class="footer-btn lead-btn" onclick="showLeaderboard()">Top Scores</button>
  </div>
</div>

<div class="overlay" id="jackpotOverlay"><div class="modal"><h2>JACKPOT!!!</h2><p id="jackpotMsg">You won 5,000 coins!</p><button class="modal-close" onclick="closeJackpot()">AMAZING!</button></div></div>
<div class="overlay" id="bonusOverlay"><div class="modal"><h2>Bonus Round!</h2><p>You collected all 6 Squishies! 3 FREE SPINS!</p><button class="modal-close" onclick="closeBonus()">LET'S GO!</button></div></div>
<div class="overlay" id="leaderOverlay"><div class="modal"><h2>Top Scores</h2><ul class="leader-list" id="leaderList"></ul><p id="currentBalance"></p><button class="modal-close" onclick="closeLeaderboard()">Close</button></div></div>

<script>
// ================================================================
// YUM SUM SQUISHIES — Deep-3D Jellycat × Dim Sum
// Material system:
//  - feSpecularLighting key light (top-left, high intensity)
//  - Multi-stop radialGradient SSS (core → mid → rim → shadow)
//  - feDropShadow hard depth shadows
//  - Rim/fresnel glow on lit edges
//  - Beaded safety eyes, embroidered smiles, corduroy boots
// ================================================================

// ── Jellycat eye (beaded plastic, 3-layer highlight) ────────────
function eye(cx, cy, r) {
  return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="#0a0a0a"/>
  <circle cx="${cx-r*0.28}" cy="${cy-r*0.28}" r="${r*0.48}" fill="rgba(255,255,255,0.95)"/>
  <circle cx="${cx-r*0.58}" cy="${cy-r*0.58}" r="${r*0.20}" fill="rgba(255,255,255,0.7)"/>`;
}

// ── Embroidered smile ──────────────────────────────────────────
function smile(x, y, w) {
  return `<path d="M${x} ${y} Q${x+w*0.5} ${y+w*0.40} ${x+w} ${y}" stroke="#180800" stroke-width="1.8" fill="none" stroke-linecap="round"/>`;
}

// ── Blush cheeks (soft pink ovals) ─────────────────────────────
function blush(cx, cy) {
  return `<ellipse cx="${cx-7}" cy="${cy}" rx="5.5" ry="3.5" fill="rgba(255,115,130,0.50)"/>
  <ellipse cx="${cx+7}" cy="${cy}" rx="5.5" ry="3.5" fill="rgba(255,115,130,0.50)"/>`;
}

// ── Corduroy boots (ribbed capsule + horizontal lines) ────────
function boots(x, y, color) {
  let s = `<rect x="${x}" y="${y}" width="8" height="13" rx="4" fill="${color}"/>`;
  for (let i = 0; i < 4; i++) {
    const lx = x + 1.5 + i * 1.8;
    s += `<line x1="${lx}" y1="${y+1.5}" x2="${lx}" y2="${y+11.5}" stroke="rgba(0,0,0,0.22)" stroke-width="0.9"/>`;
  }
  return s;
}

// ── Specular highlight factory ─────────────────────────────────
function specHighlight(cx, cy, rx, ry, intensity) {
  return `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${ry}" fill="rgba(255,255,255,${intensity})"/>`;
}

// ── Slot symbols ───────────────────────────────────────────────
const SYMBOLS = {

  // ── BAO-BAO — Common ─────────────────────────────────────
  // XL Xiaolongbao: SSS maltose gel body, pinched pleat top,
  // translucent soup glow inside, dangling corduroy boots
  baobao: {
<<<<<<< HEAD
    svg: `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 64 64" width="64" height="64"><image width="64" height="64" xlink:href="data:image/png;base64,"/></svg>`,
=======
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <radialGradient id="baoBody" cx="38%" cy="32%" r="65%">
      <stop offset="0%"   stop-color="#ffffff"/>
      <stop offset="25%"  stop-color="#fde8dc"/>
      <stop offset="55%"  stop-color="#f5c4a8"/>
      <stop offset="80%"  stop-color="#d4886a"/>
      <stop offset="100%" stop-color="#8a4830"/>
    </radialGradient>
    <radialGradient id="baoSoup" cx="50%" cy="55%" r="45%">
      <stop offset="0%"   stop-color="rgba(255,210,120,0.55)"/>
      <stop offset="100%" stop-color="rgba(255,140,40,0)"/>
    </radialGradient>
    <radialGradient id="baoHighlight" cx="30%" cy="26%" r="55%">
      <stop offset="0%"   stop-color="rgba(255,255,255,0.85)"/>
      <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
    </radialGradient>
    <filter id="baoShadow" x="-40%" y="-40%" width="180%" height="190%">
      <feDropShadow dx="2" dy="7" stdDeviation="6" flood-color="rgba(100,40,10,0.55)"/>
    </filter>
    <linearGradient id="baoPleat" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%"   stop-color="rgba(180,120,80,0.5)"/>
      <stop offset="50%"  stop-color="rgba(255,220,195,0.35)"/>
      <stop offset="100%" stop-color="rgba(180,120,80,0.5)"/>
    </linearGradient>
  </defs>
  <ellipse cx="32" cy="61" rx="20" ry="6" fill="rgba(0,0,0,0.32)"/>
  <ellipse cx="32" cy="46" rx="14" ry="10" fill="url(#baoSoup)"/>
  <ellipse cx="32" cy="36" rx="22" ry="22" fill="url(#baoBody)" filter="url(#baoShadow)"/>
  <ellipse cx="32" cy="34" rx="19" ry="17" fill="rgba(255,250,247,0.28)"/>
  <ellipse cx="32" cy="34" rx="19" ry="17" fill="url(#baoHighlight)"/>
